---
import Accordion from "../components/Accordion.astro";
import { faqUpdated, faqs } from "../content/faq";
import { site } from "../content/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title={`${site.name} — FAQs`}
  description="Answers about Docksly licenses, the trial, privacy, and Dock switching."
  surface="dark"
  current="faqs"
  compactFooter
>
  <article class="mx-auto w-full max-w-[40rem] px-6 pt-10 pb-8 sm:pt-16">
    <h1 class="text-5xl font-bold tracking-tight text-balance text-orange-75 sm:text-6xl">FAQs</h1>
    <p class="mt-4 flex items-center gap-2 text-sm text-orange-75/50">
      <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M7.5 3.75A2.25 2.25 0 0 0 5.25 6v12A2.25 2.25 0 0 0 7.5 20.25h9A2.25 2.25 0 0 0 18.75 18V8.56a2.25 2.25 0 0 0-.66-1.59l-3.06-3.06a2.25 2.25 0 0 0-1.59-.66H7.5Z"
        ></path>
      </svg>
      {faqUpdated}
    </p>

    <div class="mt-10">
      {
        faqs.map((item) => (
          <Accordion title={item.question}>
            <p class="text-pretty">{item.answer}</p>
            {item.question.includes("recover my license") && (
              <p class="mt-3">
                <a class="underline decoration-orange-75/30 underline-offset-4 hover:text-teal-400" href="/recover">
                  Recover your license
                </a>
              </p>
            )}
            {item.question.includes("collect any data") && (
              <p class="mt-3">
                <a class="underline decoration-orange-75/30 underline-offset-4 hover:text-teal-400" href="/privacy">
                  Privacy policy
                </a>
              </p>
            )}
          </Accordion>
        ))
      }
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-bold">Have more questions?</h2>
      <p class="mt-3 max-w-md text-pretty text-orange-75/70">
        If you have more questions, <a
          class="underline decoration-orange-75/30 underline-offset-4 hover:text-teal-400"
          href={`mailto:${site.email}?body=Hi,%0A%0AI have read the FAQs before I wrote this.%0A%0A`}
          >contact us</a
        >.
      </p>
    </section>

  </article>
</SiteLayout>
