---
import FeatureGrid from "../components/FeatureGrid.astro";
import Hero from "../components/Hero.astro";
import HeroMockup from "../components/HeroMockup.astro";
import { release } from "../content/release";
import { site } from "../content/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title={`${site.name} — Download for Mac`}
  description={`Download Docksly for ${site.macos}. ${site.trial} included.`}
  current="download"
>
  <Hero />
  <HeroMockup />
  <FeatureGrid />

  <div
    id="download-overlay"
    class="fixed inset-0 z-50 flex items-center justify-center bg-midnight/40 px-5"
    role="dialog"
    aria-modal="true"
    aria-labelledby="download-title"
  >
    <div
      class="w-full max-w-[28rem] rounded-[1.75rem] bg-canvas px-8 py-10 text-center shadow-2xl shadow-ink/25"
    >
      <h2 id="download-title" class="text-2xl font-bold text-ink">Checking download</h2>
      <p id="download-copy" class="mt-3 text-pretty text-ink-muted">
        Checking for the Docksly disk image.
      </p>
      <a
        id="download-file"
        href={site.downloadPath}
        class="btn-press mt-6 inline-flex rounded-2xl bg-accent px-5 py-3 text-base font-bold text-paper"
      >
        Download Docksly.dmg
      </a>
      <p class="mt-4 text-sm text-ink-muted">{site.macos}. {site.trial} included.</p>
      <dl class="mt-6 grid gap-2 rounded-2xl bg-wash px-5 py-4 text-left text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-ink-muted">Version</dt>
          <dd class="font-medium text-ink tabular-nums">{release.version}</dd>
        </div>
        {
          release.dmg && (
            <div class="flex justify-between gap-4">
              <dt class="text-ink-muted">Size</dt>
              <dd class="font-medium text-ink tabular-nums">{release.dmg.size}</dd>
            </div>
          )
        }
        <div class="flex justify-between gap-4">
          <dt class="text-ink-muted">Developer</dt>
          <dd class="text-right font-medium text-ink">{release.developer}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-ink-muted">Security</dt>
          <dd class="text-right font-medium text-ink">Signed and notarized by Apple</dd>
        </div>
        {
          release.dmg && (
            <div>
              <dt class="text-ink-muted">SHA-256</dt>
              <dd class="mt-1 font-mono text-xs break-all text-ink">{release.dmg.sha256}</dd>
            </div>
          )
        }
      </dl>
      <p class="mt-4 text-sm text-pretty text-ink-muted">
        Also on <a href={release.github} rel="noreferrer" class="underline underline-offset-4">GitHub Releases</a>
        or with <code class="font-mono text-xs">{release.brew}</code>
      </p>
      <a
        id="download-close"
        href="/"
        class="mt-6 inline-block text-sm font-medium text-ink-muted underline underline-offset-4"
      >
        Back to home
      </a>
    </div>
  </div>
</SiteLayout>

<script>
  const title = document.getElementById("download-title");
  const copy = document.getElementById("download-copy");
  const link = document.getElementById("download-file");
  const close = document.getElementById("download-close");
  const overlay = document.getElementById("download-overlay");
  const path = link instanceof HTMLAnchorElement ? link.getAttribute("href") : null;

  function markMissing() {
    if (title) title.textContent = "Download not ready";
    if (copy) {
      copy.textContent =
        "The disk image is not published yet. Drop Docksly.dmg into web/public when you are ready.";
    }
    if (link instanceof HTMLAnchorElement) {
      link.hidden = true;
    }
  }

  async function startDownload() {
    if (!path || !copy || !(link instanceof HTMLAnchorElement)) return;
    try {
      const response = await fetch(path, { method: "HEAD" });
      if (!response.ok) {
        markMissing();
        close?.focus();
        return;
      }
      if (title) title.textContent = "Download started";
      copy.textContent = "If the file did not start, use the link below.";
      const trigger = document.createElement("a");
      trigger.href = path;
      trigger.setAttribute("download", "Docksly.dmg");
      trigger.hidden = true;
      document.body.append(trigger);
      trigger.click();
      trigger.remove();
      link.focus();
    } catch {
      markMissing();
      close?.focus();
    }
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      window.location.href = "/";
    }
  });

  overlay?.addEventListener("click", (event) => {
    if (event.target === overlay) {
      window.location.href = "/";
    }
  });

  void startDownload();
</script>
