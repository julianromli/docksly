---
import Accordion from "../components/Accordion.astro";
import { changelogUpdated, releases } from "../content/changelog";
import { site } from "../content/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const major = releases.find((item) => item.version === "1.0");
const patches = releases.filter((item) => item.version !== "1.0");

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}
---

<SiteLayout
  title={`${site.name} — Changelog`}
  description="See what is new in Docksly."
  surface="dark"
  current="changelog"
  compactFooter
>
  <article class="mx-auto w-full max-w-[40rem] px-6 pt-10 pb-8 sm:pt-16">
    <h1 class="text-5xl font-bold tracking-tight text-balance text-paper sm:text-6xl">
      Changelog
    </h1>
    <p class="mt-4 flex items-center gap-2 text-sm text-paper/60">
      <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M7.5 3.75A2.25 2.25 0 0 0 5.25 6v12A2.25 2.25 0 0 0 7.5 20.25h9A2.25 2.25 0 0 0 18.75 18V8.56a2.25 2.25 0 0 0-.66-1.59l-3.06-3.06a2.25 2.25 0 0 0-1.59-.66H7.5Z"
        ></path>
      </svg>
      {changelogUpdated}
    </p>

    {
      major && (
        <section class="mt-14 scroll-mt-32" id={major.id}>
          <h2 class="text-3xl font-bold">{major.version}</h2>
          <p class="mt-3 max-w-xl text-pretty text-paper/70">{major.summary}</p>
        </section>
      )
    }

    <div class="mt-8">
      {
        patches.map((item) => (
          <Accordion title={item.version} meta={formatDate(item.date)}>
            {item.notes && <p class="mb-4 text-pretty">{item.notes}</p>}
            {item.features && item.features.length > 0 && (
              <>
                <h3 class="mb-2 font-semibold text-paper">Features ({item.features.length})</h3>
                <ul class="mb-4 list-disc space-y-1 pl-5">
                  {item.features.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </>
            )}
            {item.fixes && item.fixes.length > 0 && (
              <>
                <h3 class="mb-2 font-semibold text-paper">Fixes ({item.fixes.length})</h3>
                <ul class="list-disc space-y-1 pl-5">
                  {item.fixes.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </>
            )}
          </Accordion>
        ))
      }
    </div>

    <p class="mt-12 text-sm text-paper/70">
      <a class="underline decoration-paper/30 underline-offset-4 hover:text-paper" href="/changelog/rss.xml"
        >RSS feed</a
      >
    </p>
  </article>
</SiteLayout>
