---
import { site } from "../content/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title={`${site.name} — Page not found`}
  description="This page is not on the Docksly site."
  compactFooter
>
  <section class="mx-auto max-w-[40rem] px-6 pt-20 text-center">
    <h1 class="text-5xl font-bold tracking-tight text-balance sm:text-6xl">Page not found</h1>
    <p class="mt-4 text-stone-600">This address is not on the Docksly site.</p>
    <a
      href="/"
      class="btn-press mt-8 inline-flex rounded-2xl bg-stone-800 px-5 py-3 font-bold text-orange-75"
    >
      Go home
    </a>
  </section>
</SiteLayout>
