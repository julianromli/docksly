<figure class="mx-auto mt-12 w-full max-w-[56rem] px-5 sm:mt-16 sm:px-8">
  <div
    class="relative overflow-hidden rounded-[1.75rem] bg-midnight shadow-[0_2px_16px_0_rgba(12,10,9,0.25)] shadow-xl ring ring-ink/10 sm:rounded-[1.875rem]"
  >
    <video
      id="hero-video"
      class="block aspect-[1920/1202] w-full object-cover"
      width="1920"
      height="1202"
      poster="/hero.jpg"
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
      aria-label="Docksly demo on a Mac"
    >
      <source src="/hero.mp4" type="video/mp4" />
    </video>
  </div>

  <figcaption class="mt-4 text-center text-sm font-medium text-ink-muted">
    Docksly on a Mac
  </figcaption>
</figure>

<script>
  const video = document.getElementById("hero-video");
  if (!(video instanceof HTMLVideoElement)) {
    // No video node.
  } else if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.pause();
    video.removeAttribute("autoplay");
  } else {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) {
          void video.play();
        } else {
          video.pause();
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(video);
  }
</script>
