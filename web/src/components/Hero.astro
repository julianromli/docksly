---
import { site } from "../content/site";
import DownloadButton from "./DownloadButton.astro";
import PurchaseButton from "./PurchaseButton.astro";
---

<section class="mx-auto max-w-[52rem] px-5 pt-10 text-center sm:pt-14">
  <h1
    class="text-[clamp(1.75rem,10.5vw,3.75rem)] leading-[1.08] font-bold tracking-tight text-ink sm:text-8xl sm:leading-none"
  >
    <span class="whitespace-nowrap">{site.headline}</span>
    <br />
    <span class="whitespace-nowrap">
      {site.headlineLine2}{" "}
      <svg
        class="me-[0.12em] inline-block h-[0.86em] w-auto align-[-0.08em] fill-current"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
        ></path>
      </svg>{site.highlight}
    </span>
  </h1>

  <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:mt-10 sm:flex-row sm:gap-4">
    <DownloadButton variant="solid" />
    <PurchaseButton />
  </div>
</section>
