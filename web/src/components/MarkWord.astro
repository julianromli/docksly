---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<mark
  class:list={[
    "relative inline-block bg-transparent px-1 font-extrabold text-ink dark:text-paper",
    className,
  ]}
>
  <slot />
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -bottom-1 -z-10 h-[0.5em] rounded-xs bg-mark md:-bottom-2"
  ></span>
</mark>
