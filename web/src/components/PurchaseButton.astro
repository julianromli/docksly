---
import { site } from "../content/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={site.checkout}
  class:list={[
    "btn-press relative inline-flex items-center justify-center rounded-2xl bg-wash py-4 pr-5 pl-12 text-lg font-bold text-ink",
    className,
  ]}
>
  <span class="absolute top-1/2 left-5 size-[18px] -translate-y-1/2" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="size-full fill-current" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M12 2.25a9.75 9.75 0 1 1 0 19.5 9.75 9.75 0 0 1 0-19.5Zm0 1.5a8.25 8.25 0 1 0 0 16.5 8.25 8.25 0 0 0 0-16.5Zm3.53 5.47a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06L10.5 12.69l3.97-3.97a.75.75 0 0 1 1.06 0Z"
      ></path>
    </svg>
  </span>
  <span>Purchase</span>
  <span class="ml-1.5 tabular-nums">{site.price}</span>
</a>
