---
import type { FeatureIcon } from "../content/features";

interface Props {
  name: FeatureIcon;
}

const { name } = Astro.props;
---

{
  name === "docks" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <circle cx="8" cy="16" r="4" />
      <circle cx="16" cy="16" r="4" />
      <circle cx="24" cy="16" r="4" />
    </svg>
  )
}
{
  name === "apply" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 3a13 13 0 1 1 0 26 13 13 0 0 1 0-26Zm0 2a11 11 0 1 0 0 22 11 11 0 0 0 0-22Zm5.2 7.1a1 1 0 0 1 0 1.4l-6.2 6.2a1 1 0 0 1-1.4 0l-2.8-2.8a1 1 0 1 1 1.4-1.4l2.1 2.1 5.5-5.5a1 1 0 0 1 1.4 0Z" />
    </svg>
  )
}
{
  name === "menubar" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M6 8h20a2 2 0 0 1 2 2v3H4v-3a2 2 0 0 1 2-2Zm-2 7h24v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-9Zm4-5.2a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Zm3.5 0a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Zm3.5 0a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Z" />
    </svg>
  )
}
{
  name === "spacers" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <rect x="4" y="12" width="8" height="8" rx="2" />
      <rect x="20" y="12" width="8" height="8" rx="2" />
      <rect x="15" y="10" width="2" height="12" rx="1" />
    </svg>
  )
}
{
  name === "reorder" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M10 7.5 6 11.5h3V20h2v-8.5h3L10 7.5Zm12 17 4-4h-3V12h-2v8.5h-3l4 4Z" />
    </svg>
  )
}
{
  name === "folders" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M4 9a3 3 0 0 1 3-3h5.2l2.5 2.5H25a3 3 0 0 1 3 3V23a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9Zm3-1a1 1 0 0 0-1 1v2.5h20V11.5a1 1 0 0 0-1-1H13.9l-2.5-2.5H7Zm-1 5.5V23a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-9.5H6Z" />
    </svg>
  )
}
{
  name === "appearance" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M5 9h12.2a3 3 0 0 1 5.6 0H27v2h-4.2a3 3 0 0 1-5.6 0H5V9Zm15 2a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM5 21h4.2a3 3 0 0 1 5.6 0H27v2H14.8a3 3 0 0 1-5.6 0H5v-2Zm7 2a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" />
    </svg>
  )
}
{
  name === "hotkeys" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M6 9h20a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h20a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1H6Zm2 2h2v2H8v-2Zm4 0h2v2h-2v-2Zm4 0h2v2h-2v-2Zm4 0h4v2h-4v-2ZM10 17h12v2H10v-2Z" />
    </svg>
  )
}
{
  name === "shortcuts" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M11 4h10l-4 5h8a3 3 0 0 1 2.3 4.9L19 24h-4l7-9h-9l4-5h-6a3 3 0 0 1-2.3-4.9L11 4Zm-6 15h8l-4 5H5a1 1 0 0 1-.8-1.6L5 19Z" />
    </svg>
  )
}
{
  name === "focus" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M13.5 4.3a1 1 0 0 1 .9 1.4A9 9 0 0 0 26.3 17.6a1 1 0 0 1 1.4.9A12 12 0 1 1 13.5 4.3Z" />
    </svg>
  )
}
{
  name === "capture" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M15 5h2v6h6v2h-6v6h-2v-6H9v-2h6V5ZM5 22h22a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2Z" />
    </svg>
  )
}
{
  name === "export" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 5v14l5-5 1.4 1.4L16 22.8l-6.4-6.4L11 15l5 5V5h0ZM7 24h18v2H7v-2Z" />
    </svg>
  )
}
{
  name === "trial" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 5a11 11 0 1 1 0 22 11 11 0 0 1 0-22Zm0 2a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm1 4v5.2l3.4 2a1 1 0 1 1-1 1.8l-4.1-2.4A1 1 0 0 1 14.5 16V11a1 1 0 1 1 2 0Z" />
    </svg>
  )
}
{
  name === "native" && (
    <svg class="size-8 fill-current sm:size-10" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M17.2 4 8 18h7l-1.2 10L24 14h-7L17.2 4Z" />
    </svg>
  )
}
