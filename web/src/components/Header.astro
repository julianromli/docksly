---
import type { NavId } from "../content/site";
import { site } from "../content/site";
import AppMark from "./AppMark.astro";
import DownloadButton from "./DownloadButton.astro";

interface Props {
  current?: NavId;
}

const { current = "home" } = Astro.props;

const showFaqs = current !== "faqs";
const showChangelog = current !== "changelog";
const showDownload = current !== "recover";
---

<header
  class="relative z-40 mx-auto flex w-full max-w-screen-3xl flex-nowrap items-center justify-between gap-2 px-3 pt-3 pb-2 sm:px-8 sm:pt-5"
  transition:name="site-header"
>
  <div class="intro-mark flex items-center gap-2">
    <a href="/" class="btn-press flex items-center gap-2 rounded-2xl p-1.5" aria-label="Go home">
      <AppMark class="size-[26px] shrink-0 sm:size-[30px]" />
      <span class="text-[15px] font-bold sm:text-base">{site.name}</span>
    </a>
    <a
      href="/changelog"
      class="btn-press rounded-lg px-[5.5px] py-[2.5px] text-[12px] font-bold text-ink-muted dark:text-paper/75"
      aria-label={`View changelog, version ${site.version}`}
    >
      v{site.version}
    </a>
  </div>

  <nav class="intro-nav flex shrink-0 items-center" aria-label="Site">
    {
      showFaqs && (
        <a
          href="/faqs"
          class="btn-press inline-flex size-11 items-center justify-center gap-2 rounded-2xl sm:h-auto sm:w-auto sm:px-5 sm:py-4 sm:text-lg sm:font-bold"
        >
          <svg class="size-[18px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.75 4.5A2.25 2.25 0 0 0 4.5 6.75v7.5A2.25 2.25 0 0 0 6.75 16.5h2.69l3.28 2.46a.75.75 0 0 0 1.28-.53v-1.93h3.25A2.25 2.25 0 0 0 19.5 14.25v-7.5A2.25 2.25 0 0 0 17.25 4.5H6.75Zm0 1.5h10.5a.75.75 0 0 1 .75.75v7.5a.75.75 0 0 1-.75.75h-4a.75.75 0 0 0-.75.75v1.1l-2.22-1.66a.75.75 0 0 0-.45-.16H6.75a.75.75 0 0 1-.75-.75v-7.5a.75.75 0 0 1 .75-.75Z" />
          </svg>
          <span class="sr-only sm:not-sr-only">FAQs</span>
        </a>
      )
    }
    {
      showChangelog && (
        <a
          href="/changelog"
          class="btn-press inline-flex size-11 items-center justify-center gap-2 rounded-2xl sm:h-auto sm:w-auto sm:px-5 sm:py-4 sm:text-lg sm:font-bold"
        >
          <svg class="size-[18px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.5 3.75A2.25 2.25 0 0 0 5.25 6v12A2.25 2.25 0 0 0 7.5 20.25h9A2.25 2.25 0 0 0 18.75 18V8.56a2.25 2.25 0 0 0-.66-1.59l-3.06-3.06a2.25 2.25 0 0 0-1.59-.66H7.5Zm0 1.5h5.25v2.81c0 .414.336.75.75.75h2.81V18a.75.75 0 0 1-.75.75h-9a.75.75 0 0 1-.75-.75V6A.75.75 0 0 1 7.5 5.25ZM8.25 12a.75.75 0 0 1 .75-.75h6a.75.75 0 0 1 0 1.5h-6a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75Z" />
          </svg>
          <span class="sr-only sm:not-sr-only">Changelog</span>
        </a>
      )
    }
    {
      showDownload && (
        <div class="max-sm:hidden">
          <DownloadButton variant="nav" class="ml-1" />
        </div>
      )
    }
    {
      showDownload && (
        <a
          href="/download"
          class="btn-press ml-1 inline-flex size-11 items-center justify-center rounded-2xl bg-wash text-ink sm:hidden"
          aria-label="Download for Mac"
        >
          <svg class="size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
          </svg>
        </a>
      )
    }
  </nav>
</header>
